# Generic R + RStudio + macOS + TeX exclusions.
# Project-specific or private patterns live in .git/info/exclude
# (which is local-only and NEVER committed).

# R session / RStudio metadata
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj

# Build artefacts
*.tar.gz
*.log
*.aux
*.bbl
*.blg
*.out
*.toc
*.synctex.gz

# Generated docs and build outputs (regenerated from source)
output/
docs/

# OS junk
.DS_Store

# Paper drafts (ignored while under review)
paper/
paper-jss/
paper-rj/

# Reference copy of the REndo package (JSS exemplar), kept locally only
REndo/

# Local copies of the source papers, used to verify the replications
# against their published tables and figures. Kept out of git: they are
# other authors' work, and redistributing them from this repo -- or
# shipping them in a CRAN tarball -- is a separate decision from reading
# them. Fetch them from arXiv/NBER if you need them.
reference-papers/

# R CMD check output
*.Rcheck/
